        "cidades = []\n",
        "menuAtivo = True\n",
        "def cidadesF():\n",
        "  for i in range(len(cidades)):\n",
        "    print(cidades[i])\n",
        "\n",
        "\n",
        "while(menuAtivo == True):\n",
        "  dgit = input(\"Digite o nome da cidade para armazenar ou digite sair para cancelar o programa: \")\n",
        "  dgit = dgit.lower()\n",
        "  if(dgit == \"sair\" ):\n",
        "    cidadesF()\n",
        "    menuAtivo = False\n",
        "\n",
        "  else:\n",
        "    dgit = dgit[0].upper()+dgit[1:]\n",
        "    cidades.append(dgit)\n",
        "\n",
        "\n",
        "\n"
      ]
